APP_ENV=local
LOG_LEVEL=INFO
ROUNDING_POLICY_VERSION=v1

# Canonical hostnames remain the in-code defaults for non-containerized and ingress-routed environments.
# For local Docker runs against host-exposed services, lotus-risk keeps canonical upstream hostnames
# and uses the host-exposed service ports through extra_hosts.
LOTUS_CORE_BASE_URL=http://core-control.dev.lotus:8202
LOTUS_CORE_TIMEOUT_SECONDS=10
LOTUS_PERFORMANCE_BASE_URL=http://performance.dev.lotus:8002
LOTUS_PERFORMANCE_TIMEOUT_SECONDS=10
LOTUS_PERFORMANCE_ASYNC_POLL_INTERVAL_SECONDS=1
LOTUS_PERFORMANCE_ASYNC_MAX_POLLS=60
